# Git & JJ Ignore for vector-gate

# Excluded non-core components (local only, do not track in Git)
.dockerignore
deploy/
docs/
research/
test/

# Trash & temporary files
trash/
tele_offset.txt
.last_offset
inbox_history.jsonl
.agents/

# Large data & archives
*.zip
*.tar.gz
*.evtx
large_sample_2gb.evtx

# Go runtime & binaries
go/
vector-portable/

# Cargo build artifacts
target/
**/target/

# Logs & temp outputs
*.log
*.ndjson
*.jsonl
__pycache__/
*.pyc

vrl-mod/
haproxy_analysis/
