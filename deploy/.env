# ==============================================================================
# VECTOR SMART GATE: ENVIRONMENT CONFIGURATION (.env)
# 12-Factor App Deployment Specification
# ==============================================================================

# 1. Container & Image Metadata
VECTOR_GATE_IMAGE=l1ghtg3m/vector-gate:2.5.6
CONTAINER_NAME=vector-smart-gate
RESTART_POLICY=unless-stopped

# 2. Ingress & Telemetry Port Configuration (Flexible & Dynamic)
GATE_PORT=5000
TELEMETRY_PORT=9100

# 3. Process Logging & Runtime Allocator
RUST_LOG=info
VECTOR_LOG=info
MALLOC_CONF=dirty_decay_ms:0,muzzy_decay_ms:0

# 4. OS Resource Hardening & Termination Grace Period
NOFILE_LIMIT=1048576
STOP_GRACE_PERIOD=30s

# 5. Local Storage & Pipeline Mounts
CONFIG_FILE=./config/vector.yaml
VRL_DIR=./vrl
LOG_OUTPUT_DIR=./output

