#---
# match_contains: "type="
# scope: syslog
# vendor: Linux Auditd
# priority: 5
#---
if contains(string!(.message), "type=") && contains(string!(.message), "msg=audit(") {
    parsed, err = parse_key_value(.message)
    if err == null {
        . = merge!(., parsed)
        .parsed = true
        .vendor = "Linux Auditd"

        # Xử lý trường msg (có thể là array gồm header audit() và body msg='...')
        if is_array(.msg) {
            msg_arr = array!(.msg)
            for_each(msg_arr) -> |_i, val| {
                val_str = string!(val)
                if contains(val_str, "audit(") {
                    audit_meta, meta_err = parse_regex(val_str, r'audit\((?P<audit_epoch>[0-9.]+):(?P<audit_id>\d+)\)')
                    if meta_err == null {
                        .audit_epoch = audit_meta.audit_epoch
                        .audit_id = audit_meta.audit_id
                    }
                } else if contains(val_str, "=") {
                    inner_kv, inner_err = parse_key_value(val_str)
                    if inner_err == null {
                        . = merge!(., inner_kv)
                    }
                }
            }
        } else if is_string(.msg) {
            msg_str = string!(.msg)
            audit_meta, meta_err = parse_regex(msg_str, r'audit\((?P<audit_epoch>[0-9.]+):(?P<audit_id>\d+)\)')
            if meta_err == null {
                .audit_epoch = audit_meta.audit_epoch
                .audit_id = audit_meta.audit_id
            }
        }

        # Giải mã hex command (Linux Auditd tự mã hóa hex Base16 khi có khoảng trắng)
        if exists(.cmd) && is_string(.cmd) {
            decoded_cmd, d_err = decode_base16(string!(.cmd))
            if d_err == null {
                .cmd = string!(decoded_cmd)
            }
        }
    }
}
