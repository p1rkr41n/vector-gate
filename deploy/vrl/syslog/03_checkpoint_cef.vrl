#---
# match_prefix: "CEF:"
# scope: syslog
# vendor: CheckPoint
# priority: 3
#---
if starts_with(string!(.message), "CEF:") {
    parsed, err = parse_regex(.message, r'^CEF:(?P<cef_ver>\d+)\|(?P<vendor>[^|]{1,64})\|(?P<product>[^|]{1,64})\|(?P<version>[^|]{1,32})\|(?P<sig_id>[^|]{1,32})\|(?P<name>[^|]{1,128})\|(?P<severity>[^|]{1,16})\|(?P<extension>.*)$')
    if err == null {
        . = merge(., parsed)
        .parsed = true
        .vendor = "CheckPoint"
    }
}
