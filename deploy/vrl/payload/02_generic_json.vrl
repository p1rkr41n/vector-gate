#---
# match_prefix: "{"
# scope: payload
# priority: 2
#---
parsed, err = parse_json(.message)
if err == null {
    if is_object(parsed) {
        # Bảo vệ các trường định tuyến hệ thống không bị ghi đè bởi payload JSON
        del(parsed.type_log)
        del(parsed.source_id)
        del(parsed.ingress_port)
        del(parsed.parsed)
        ., err = merge(., parsed)
    } else {
        .payload = parsed
    }
    .parsed = true
}
